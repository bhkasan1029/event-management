# Supabase / local Postgres connection string
# Example (local): postgresql://postgres:postgres@localhost:5432/eventdb
# Example (Supabase pooled): postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Example (Supabase direct, for migrations): postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/eventdb"

# Google Maps API key (restrict to your domains in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
SOLVER_URL="http://localhost:8001"
